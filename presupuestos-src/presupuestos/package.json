{
  "name": "cotizador-renting-corporativo",
  "private": true,
  "version": "1.0.0",
  "description": "Cotizador de alquiler de vehículos a largo plazo con exportación a PDF.",
  "author": "Grupo Randazzo",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:win": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@react-pdf/renderer": "^3.4.5",
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.2.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "build": {
    "appId": "com.gruporandazzo.cotizadorrenting",
    "productName": "Cotizador Renting Corporativo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cotizador Renting Corporativo"
    }
  }
}
